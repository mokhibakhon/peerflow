{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "cleanUrls": true,
  "buildCommand": "",
  "outputDirectory": ".",
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/404",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/aiml",
      "destination": "/ai-machine-learning-study-partner",
      "permanent": true
    },
    {
      "source": "/backend",
      "destination": "/backend-study-partner",
      "permanent": true
    },
    {
      "source": "/cybersecurity",
      "destination": "/cybersecurity-study-partner",
      "permanent": true
    },
    {
      "source": "/data",
      "destination": "/data-science-study-partner",
      "permanent": true
    },
    {
      "source": "/devops",
      "destination": "/devops-cloud-study-partner",
      "permanent": true
    },
    {
      "source": "/frontend",
      "destination": "/frontend-study-partner",
      "permanent": true
    },
    {
      "source": "/mobile",
      "destination": "/mobile-development-study-partner",
      "permanent": true
    },
    {
      "source": "/design",
      "destination": "/ux-ui-design-study-partner",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://lh3.googleusercontent.com; media-src 'self' blob:; connect-src 'self' https://ooolpkdqrfhnmcmdqhau.supabase.co wss://ooolpkdqrfhnmcmdqhau.supabase.co https://*.livekit.cloud wss:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self), geolocation=(), payment=(), usb=(), interest-cohort=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
